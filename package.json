{
  "name": "vue-reader",
  "version": "1.3.7",
  "type": "module",
  "main": "lib/vue-reader.cjs.js",
  "module": "lib/vue-reader.es.js",
  "files": [
    "lib"
  ],
  "types": "lib/index.d.ts",
  "keywords": [
    "vue3",
    "vue2",
    "epub",
    "epubjs",
    "reader"
  ],
  "homepage": "https://jinhuan138.github.io/vue-reader/",
  "repository": {
    "type": "git",
    "url": "git@github.com:jinhuan138/vue-reader.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json --composite false",
    "format": "prettier --write src/packages/**/*.{ts,vue}",
    "docs:dev": "pnpm -F ./docs run docs:dev",
    "docs:build": "pnpm -F ./docs run docs:build",
    "docs:preview": "pnpm -F ./docs run docs:preview",
    "reader": "pnpm -F ./reader run dev"
  },
  "license": "Apache",
  "bugs": {
    "url": "https://github.com/jinhuan138/vue-reader/issues"
  },
  "dependencies": {
    "epubjs": "^0.3.93"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "prettier": "^2.8.8",
    "typescript": "^5.9.3",
    "unplugin-dts": "1.0.3",
    "vite": "catalog:",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue": "^3.5.31",
    "vue-reader": "catalog:",
    "vue-tsc": "^3.2.6"
  },
  "browserslist": [
    "defaults",
    "not ie < 8",
    "last 2 versions",
    "> 1%",
    "iOS 7",
    "last 3 iOS versions"
  ],
  "packageManager": "pnpm@9.6.0"
}